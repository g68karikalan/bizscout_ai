PORT=3001
NODE_ENV=development
MOCK_DATA_MODE=false

# Supabase (https://supabase.com)
# Use publishable key for client/normal access
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Groq AI (https://console.groq.com)
GROQ_API_KEY=gsk_your-groq-key

# Overpass / OpenStreetMap (No API key needed)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# Google Places (OPTIONAL - Not configured)
GOOGLE_PLACES_API_KEY=

# Hunter.io (OPTIONAL - Not configured)
HUNTER_API_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
